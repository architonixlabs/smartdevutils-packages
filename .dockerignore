# Build context for apps/playground/Dockerfile (repo root). The image installs and builds everything itself,
# so local installs and build output stay out. Keep every package.json, source file and the lockfile.
**/node_modules
**/dist
**/out
**/coverage
**/.turbo
**/.angular
**/.vite
**/*.tsbuildinfo
**/*.log
.git
.github
.changeset
.vscode
.idea

# Generated by the build inside the image.
apps/playground/public/runtime
apps/playground/public/sandbox.js
apps/playground/src/assets/docs.json
packages/elements/custom-elements.json

# Secrets never go in an image.
**/.env
**/.env.*
