{
  "name": "@smartdevutils/recipes",
  "version": "0.1.0",
  "description": "SmartDevUtils recipes (tool chains) as data, plus a headless engine that runs them through @smartdevutils/core tool runners and records sdu-recipe-run/1 files.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@smartdevutils/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "~5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "smartdevutils",
    "recipes",
    "pipeline",
    "headless",
    "developer-tools"
  ],
  "author": "ArchitonixLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArchitonixLabs/smartdevutils-packages"
  }
}
