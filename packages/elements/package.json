{
  "name": "@smartdevutils/elements",
  "version": "1.3.1",
  "description": "Web Components (Lit) for SmartDevUtils: a generic <sdu-tool> driven by the core tool runners, <sdu-diagram> for Mermaid, and <sdu-recipe> / <sdu-recipe-run> for tool chains. Works in any framework or plain HTML.",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tool": {
      "types": "./dist/tool.d.ts",
      "import": "./dist/tool.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./diagram": {
      "types": "./dist/diagram.d.ts",
      "import": "./dist/diagram.js"
    },
    "./recipe": {
      "types": "./dist/recipe.d.ts",
      "import": "./dist/recipe.js"
    },
    "./recipe-run": {
      "types": "./dist/recipe-run.d.ts",
      "import": "./dist/recipe-run.js"
    },
    "./cdn": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cdn/sdu-elements.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/tool.js",
    "./dist/tools.js",
    "./dist/diagram.js",
    "./dist/recipe.js",
    "./dist/recipe-run.js",
    "./dist/cdn/*.js"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.cdn.config.ts && node scripts/manifest.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@smartdevutils/browser": "workspace:^",
    "@smartdevutils/core": "workspace:^",
    "@smartdevutils/recipes": "workspace:^",
    "@smartdevutils/theme": "workspace:^",
    "lit": "^3.3.0"
  },
  "peerDependencies": {
    "mermaid": "^11.0.0 || ^12.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "happy-dom": "^20.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "smartdevutils",
    "web-components",
    "custom-elements",
    "lit",
    "mermaid",
    "developer-tools"
  ],
  "author": "ArchitonixLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/architonixlabs/smartdevutils-packages"
  },
  "engines": {
    "node": ">=20.19"
  }
}
